// Kingdom Tribe City — data architecture
// Modeled for the full ecosystem now; UI depth varies by module (see docs/ROADMAP.md)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & Auth (Auth.js compatible)
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MINISTRY_LEADER
  INSTRUCTOR
  MENTOR
  STUDENT
  MEMBER
  GUEST
}

enum Stage {
  PLANTED
  ROOTED
  FORMED
  FRUITFUL
  SENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  role  Role  @default(STUDENT)
  stage Stage @default(PLANTED)

  sphereOfInfluence String?
  bio               String?
  onboardedAt       DateTime?

  accounts Account[]
  sessions Session[]

  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  reflectionEntries ReflectionEntry[]
  journalEntries    JournalEntry[]
  certificates      Certificate[]

  tribeMemberships   TribeMembership[]
  mentoredTribes     Tribe[]             @relation("TribeMentor")
  discussionPosts    DiscussionPost[]
  discussionComments DiscussionComment[]
  prayerRequests     PrayerRequest[]
  testimonies        Testimony[]

  eventRegistrations EventRegistration[]
  transactions       Transaction[]

  authoredCourses  Course[]       @relation("CourseAuthor")
  mentoredCourses  CourseMentor[]
  createdResources Resource[]     @relation("ResourceCreator")
  uploadedMedia    MediaAsset[]
  quizAttempts     QuizAttempt[]
  updatedIntegrations Integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([stage])
}

// ─────────────────────────────────────────────────────────────────────────
// Permissions — scalable RBAC: roles are a fixed enum, but which
// permissions each role grants is data (editable at /admin/settings/roles)
// so new capabilities don't require a code change or redeploy.
// ─────────────────────────────────────────────────────────────────────────

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  category String

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  role         Role
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────
// Media — the generic library backing every upload (Cloudflare R2)
// ─────────────────────────────────────────────────────────────────────────

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

model MediaAsset {
  id           String    @id @default(cuid())
  key          String    @unique
  url          String
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         MediaKind
  durationSec  Int?
  width        Int?
  height       Int?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  resources Resource[] @relation("ResourceMedia")

  createdAt DateTime @default(now())

  @@index([kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────
// LMS — Programs / Courses / Modules / Lessons
// ─────────────────────────────────────────────────────────────────────────

model Program {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  description String
  /** Hub page "Vision" narrative block; falls back to tagline when unset. */
  visionBody  String?
  heroImage   String?
  published   Boolean @default(true)

  featuredCourseId String?
  featuredCourse   Course? @relation("ProgramFeaturedCourse", fields: [featuredCourseId], references: [id], onDelete: SetNull)

  courses   Course[]
  events    Event[]
  resources Resource[]
  testimonies Testimony[]
  faqs      ProgramFaq[]

  /** "Also featured in" — Products owned by another Program that this Expression's Hub also surfaces. */
  featuredCourses   ProgramCourseFeature[]
  featuredEvents    ProgramEventFeature[]
  featuredResources ProgramResourceFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Ordered Q&A list rendered on an Expression's Hub page. */
model ProgramFaq {
  id        String  @id @default(cuid())
  programId String
  question  String
  answer    String
  order     Int     @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

/** Lets a Course owned by one Program also be surfaced on another Program's Hub, without duplicating the row. */
model ProgramCourseFeature {
  id        String   @id @default(cuid())
  programId String
  courseId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
}

/** Lets an Event owned by one Program also be surfaced on another Program's Hub, without duplicating the row. */
model ProgramEventFeature {
  id        String   @id @default(cuid())
  programId String
  eventId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([programId, eventId])
}

/** Lets a Resource owned by one Program also be surfaced on another Program's Hub, without duplicating the row. */
model ProgramResourceFeature {
  id         String   @id @default(cuid())
  programId  String
  resourceId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([programId, resourceId])
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/** How the course is structured/delivered — drives whether Cohorts make sense for it. */
enum CourseFormat {
  SELF_PACED
  COHORT_BASED
  CHALLENGE
  INTENSIVE
  CERTIFICATION
}

enum CourseAccessLevel {
  PUBLIC
  PRIVATE
}

enum PricingType {
  FREE
  PAID
}

model Course {
  id          String  @id @default(cuid())
  programId   String
  authorId    String?
  slug        String  @unique
  title       String
  subtitle    String?
  description String
  /** Coarse hint for single-stage courses; multi-stage courses (e.g. Rooted and Built) leave this null and tag Stage per-Module instead. */
  stage       Stage?
  coverImage  String?
  order       Int     @default(0)
  status      CourseStatus @default(DRAFT)

  category           String?
  difficulty         CourseDifficulty?
  durationLabel      String?
  startDate          DateTime?
  endDate            DateTime?
  format             CourseFormat      @default(SELF_PACED)
  accessLevel        CourseAccessLevel @default(PUBLIC)
  pricingType        PricingType       @default(FREE)
  priceCents         Int?
  certificateEnabled Boolean           @default(true)

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  author       User?         @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  mentors      CourseMentor[]
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  cohorts      Cohort[]

  /** Programs whose Hub features this course as its "Featured Course" (in addition to its owning program). */
  featuredByPrograms Program[]              @relation("ProgramFeaturedCourse")
  /** Programs whose Hub also surfaces this course alongside its owning program. */
  featuredIn         ProgramCourseFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([authorId])
  @@index([status])
}

/** Course-level default mentors (distinct from a Tribe's mentor within a specific cohort). */
model CourseMentor {
  id       String @id @default(cuid())
  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)
  /** Which stage of the Planted→Sent pathway completing this module forms — drives stage advancement. */
  stage       Stage?

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  slug     String
  title    String
  summary  String?
  order    Int    @default(0)

  teachingVideoUrl String?
  teachingAudioUrl String?
  teachingBody     String?

  scriptureRefs       String[]
  scriptureText       String?
  reflectionQuestions String[]
  prayerPrompt        String?
  assignmentPrompt    String?
  journalPrompt       String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress          LessonProgress[]
  reflectionEntries ReflectionEntry[]
  journalEntries    JournalEntry[]
  attachedResources LessonResource[]
  quiz              Quiz?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId])
}

/** Reusable content library attachments — one Resource upload can back lessons across many courses. */
model LessonResource {
  id         String @id @default(cuid())
  lessonId   String
  resourceId String
  order      Int    @default(0)

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([lessonId, resourceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Quizzes
// ─────────────────────────────────────────────────────────────────────────

model Quiz {
  id               String @id @default(cuid())
  lessonId         String @unique
  title            String
  passScorePercent Int    @default(70)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  prompt String
  order  Int    @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id           String  @id @default(cuid())
  quizId       String
  userId       String
  scorePercent Int
  passed       Boolean
  answers      Json

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quizId, userId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

model Enrollment {
  id       String           @id @default(cuid())
  userId   String
  courseId String
  cohortId String?
  status   EnrollmentStatus @default(ACTIVE)

  paymentStatus           PaymentStatus    @default(NONE)
  paymentProvider         PaymentProvider?
  stripeCheckoutSessionId String?          @unique
  paystackReference       String?          @unique

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([cohortId])
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id       String       @id @default(cuid())
  userId   String
  lessonId String
  status   LessonStatus @default(NOT_STARTED)

  teachingViewedAt DateTime?
  reflectionDoneAt DateTime?
  assignmentDoneAt DateTime?
  journalDoneAt    DateTime?
  completedAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model ReflectionEntry {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  answers  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model JournalEntry {
  id       String  @id @default(cuid())
  userId   String
  lessonId String?
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  issuedAt DateTime @default(now())
  serial   String   @unique @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─────────────────────────────────────────────────────────────────────────
// Community — Cohorts / Tribes / Discussions / Prayer / Testimonies
// ─────────────────────────────────────────────────────────────────────────

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model Cohort {
  id        String       @id @default(cuid())
  courseId  String
  slug      String       @unique
  name      String
  startDate DateTime
  endDate   DateTime?
  status    CohortStatus @default(UPCOMING)

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tribes        Tribe[]
  enrollments   Enrollment[]
  announcements Announcement[]
  events        Event[]

  createdAt DateTime @default(now())

  @@index([courseId])
}

model Tribe {
  id       String  @id @default(cuid())
  cohortId String
  slug     String  @unique
  name     String
  mentorId String?

  cohort  Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentor  User?             @relation("TribeMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  members TribeMembership[]

  discussionPosts DiscussionPost[]
  prayerRequests  PrayerRequest[]

  createdAt DateTime @default(now())

  @@index([cohortId])
}

model TribeMembership {
  id       String   @id @default(cuid())
  userId   String
  tribeId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tribe Tribe @relation(fields: [tribeId], references: [id], onDelete: Cascade)

  @@unique([userId, tribeId])
  @@index([tribeId])
}

model DiscussionPost {
  id      String @id @default(cuid())
  tribeId String
  userId  String
  body    String

  tribe    Tribe               @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]

  createdAt DateTime @default(now())

  @@index([tribeId, createdAt])
}

model DiscussionComment {
  id     String @id @default(cuid())
  postId String
  userId String
  body   String

  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

enum PrayerStatus {
  OPEN
  ANSWERED
}

model PrayerRequest {
  id      String       @id @default(cuid())
  tribeId String
  userId  String
  body    String
  status  PrayerStatus @default(OPEN)

  tribe Tribe @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tribeId, status])
}

model Testimony {
  id        String  @id @default(cuid())
  userId    String
  /** The Expression this story is about, if any — powers the Hub's Testimonials section. */
  programId String?
  title     String
  body      String
  featured  Boolean @default(false)
  approved  Boolean @default(false)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([approved, featured])
  @@index([programId])
}

// ─────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────

model Speaker {
  id    String  @id @default(cuid())
  name  String
  title String?
  bio   String?
  image String?

  events    Event[]
  resources Resource[]
}

model Event {
  id           String    @id @default(cuid())
  programId    String?
  cohortId     String?
  slug         String    @unique
  title        String
  description  String
  location     String?
  startsAt     DateTime
  endsAt       DateTime?
  coverImage   String?
  recordingUrl String?

  program  Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort   Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  speakers Speaker[]

  registrations EventRegistration[]
  /** Programs (other than the owning one) whose Hub also surfaces this event. */
  featuredIn    ProgramEventFeature[]

  createdAt DateTime @default(now())

  @@index([startsAt])
  @@index([cohortId])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Resource Library
// ─────────────────────────────────────────────────────────────────────────

enum ResourceType {
  VIDEO
  AUDIO
  SERMON
  PDF
  EBOOK
  DOCUMENT
  STUDY
  WORKBOOK
  DEVOTIONAL
  ARTICLE
  EXTERNAL_LINK
  YOUTUBE
  EVENT_RECORDING
  LIVE_REPLAY
  IMAGE
  TEACHING_NOTE
}

enum ResourceCategory {
  IDENTITY
  PRAYER
  LEADERSHIP
  PURPOSE
  RELATIONSHIPS
  SPIRITUAL_GROWTH
}

/** Who can see a resource once it's published. */
enum ResourceVisibility {
  PUBLIC
  MEMBERS
  STUDENTS
  LEADERS
}

model Resource {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  type        ResourceType
  category    ResourceCategory
  tags        String[]
  visibility  ResourceVisibility @default(PUBLIC)
  coverImage  String?
  externalUrl String?
  published   Boolean            @default(true)
  viewCount   Int                @default(0)

  speakerId String?
  speaker   Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("ResourceMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  relatedTo  Resource[] @relation("RelatedResources")
  relatedBy  Resource[] @relation("RelatedResources")

  lessonAttachments LessonResource[]
  /** Programs (other than the owning one) whose Hub also surfaces this resource. */
  featuredIn        ProgramResourceFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([visibility])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Giving
// ─────────────────────────────────────────────────────────────────────────

enum GivingType {
  ONE_TIME
  RECURRING
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Transaction {
  id                      String             @id @default(cuid())
  userId                  String?
  amountCents             Int
  currency                String             @default("usd")
  type                    GivingType
  designation             String?
  status                  TransactionStatus  @default(PENDING)
  provider                PaymentProvider    @default(STRIPE)
  stripePaymentIntentId   String?            @unique
  stripeCheckoutSessionId String?            @unique
  paystackReference       String?            @unique

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Admin / Ops
// ─────────────────────────────────────────────────────────────────────────

model Announcement {
  id        String  @id @default(cuid())
  cohortId  String?
  title     String
  body      String
  pinned    Boolean @default(false)
  published Boolean @default(true)

  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cohortId])
}

enum IntegrationType {
  EMAIL
  PAYMENTS
  AI
  SMS
}

/** SUPER_ADMIN-only, runtime-editable third-party credentials (email, payments, AI, SMS). Secrets are encrypted at rest — see lib/crypto.ts. */
model Integration {
  id               String          @id @default(cuid())
  type             IntegrationType
  provider         String
  enabled          Boolean         @default(false)
  config           Json            @default("{}")
  secretsEncrypted String?

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, provider])
}
